[
  {
    "id": 1,
    "priority": 1,
    "action": {
      "type": "modifyHeaders",
      "responseHeaders": [
        {
          "header": "content-security-policy",
          "operation": "remove"
        },
        {
          "header": "content-security-policy-report-only",
          "operation": "remove"
        },
        {
          "header": "referrer-policy",
          "operation": "remove"
        },
        {
          "header": "access-control-allow-origin",
          "operation": "set",
          "value": "*"
        }
      ]
    },
    "condition": {
      "urlFilter": "||youtube.com",
      "resourceTypes": [
        "main_frame",
        "sub_frame",
        "xmlhttprequest",
        "media"
      ]
    }
  }
]
